{
  "name": "pilotsuite-styx-e2e-tests",
  "version": "1.0.0",
  "description": "E2E screenshot and visual regression tests for PilotSuite Styx Dashboard",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "baseline:generate": "node scripts/generate-baselines.js",
    "visual:compare": "node visual-compare.js",
    "ci": "playwright test --reporter=list,junit"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/pixelmatch": "^5.0.4",
    "@types/pngjs": "^6.0.4"
  }
}
